# Public base URL used for canonical URLs, Open Graph, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://fintechsolllc.com

# Where contact / quote / partner form submissions are POSTed as JSON
# ({ form, title, submittedAt, data }). Leave empty and the forms tell visitors
# that online submission is unavailable and offer email/phone instead.
FORMS_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <token>"
FORMS_WEBHOOK_TOKEN=
